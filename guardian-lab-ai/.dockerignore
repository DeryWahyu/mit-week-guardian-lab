# Only runtime sources enter the build context. Local data and artifacts stay out.
**
!.dockerignore
!Dockerfile
!docker/
!docker/healthcheck.py
!ml/
!ml/pyproject.toml
!ml/src/
!ml/src/**
!ml/policies/
!ml/policies/shadow-runtime-manifest.json
!ml/policies/url-qr-release-gates.json
!ml/policies/v6-distribution.json
!ml/provenance/
!ml/provenance/v6-origin.json
!ml/provenance/v6-runtime-reference.json
!ml/reports/
!ml/reports/data-improvement-v6.json
!scripts/
!scripts/install_v6_model.py
**/__pycache__/
**/*.pyc
**/*.egg-info/
