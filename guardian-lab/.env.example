# Database MySQL
# Untuk proses di host. Compose development memakai service db dan volume terpisah.
DATABASE_URL="mysql://root:root@localhost:3306/guardian_lab"

# JWT & Session Secret
# Jalankan make key-generate untuk mengisi kedua key internal secara otomatis.
SESSION_SECRET="your_session_secret_32_characters_minimum_here"

# Token perangkat Fonnte.
FONNTE_TOKEN=
# Set true hanya bila reverse proxy tepercaya mengganti header X-Forwarded-For.
AUTH_TRUST_PROXY=false

# Alamat model khusus server. Compose development mengatur http://ml:8001.
# Untuk proses di host, kosongkan bila model belum dipasang; hasil menjadi UNAVAILABLE.
GUARDIAN_ML_URL=http://127.0.0.1:8001

# DeepSeek API Key untuk analisis ancaman AI cerdas (analisis ancaman URL & Bedah APK).
# Kosongkan atau gunakan default untuk mengaktifkan fallback heuristik luring secara otomatis.
DEEPSEEK_API_KEY=

# Public URL Aplikasi Web
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Broker sandbox terpisah; buat kunci acak minimal 32 karakter.
SANDBOX_BROKER_KEY=
SANDBOX_BROKER_URL=http://127.0.0.1:4011
# Host stream harus satu site dengan aplikasi; HTTPS pada deployment publik.
SANDBOX_PUBLIC_URL=http://localhost:4010
